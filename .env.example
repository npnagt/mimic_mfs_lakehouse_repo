# Copy to .env and adjust. Loaded by src/mimic_lakehouse/config.py (no extra deps).
# .env is gitignored; .env.example is committed.

AWS_REGION=us-east-2

# Every AWS resource this repo provisions is tagged Project=<PROJECT_TAG> (S3 buckets,
# IAM roles, Glue jobs / crawlers) so spend can be split from the data-warehouse repo
# (which tags Project=DWHS). Activate "Project" in Billing > Cost allocation tags.
PROJECT_TAG=LAKEHSE

# Athena workgroup for every query this repo submits. Athena bills per-TB-scanned to the
# workgroup (not the bucket), so query cost only carries the Project tag through a tagged
# workgroup. mimic4-lakehouse = Project=LAKEHSE, engine v3, otherwise identical to primary.
# Unset -> "primary" (untagged).
ATHENA_WORKGROUP=mimic4-lakehouse

# Which dataset the load / ETL / measurement drivers target when --dataset is not
# passed on the command line. One of: demodataset | fulldataset
#   demodataset  -> data/raw/mimic-iv-clinical-database-demo-2.2, resources *-demo
#   fulldataset  -> data/raw/mimic-iv-3.1-fulldataset,            resources *-full
DATASET=demodataset

# Per-dataset buckets and Glue catalog databases are derived from DATASET
# (see DatasetProfile in src/mimic_lakehouse/config.py) -- e.g.
#   raw/landing bucket : mimic4-datalake-v3-2-<demo|full>
#   Iceberg gold bucket: mimic4-lakehouse-v3-2-<demo|full>
#   raw Glue database  : mimic4_db_raw_<demo|full>
#   gold Glue database : mimic4_db_business_<demo|full>
#   NLP bucket         : mimic4-nlp-v3-2-<demo|full>
# Pass --raw-bucket / --gold-database / etc. on any driver to override one.

# Shared across both datasets (job code is identical; only data + catalog differ)
SCRIPTS_BUCKET=mimic4-glue-scripts-v3-2-bucket

# NLP result prefixes (within the per-dataset NLP bucket)
MEDSPACY_RESULTS_PREFIX=medspacy-results
RADIOLOGY_NLP_RESULTS_PREFIX=radiology-nlp-results
